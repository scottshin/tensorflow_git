<?xml version="1.0" encoding="utf-8"?>
<resources  xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme_Default" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">false</item>

        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item> <!--StatusBar-->
        <item name="colorAccent">@color/colorPrimaryLight</item>

        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="21">true</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowBackground">@color/colorPrimaryLight</item>

        <item name="android:fitsSystemWindows">true</item>
        <item name="android:clipToPadding">true</item>

        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:splitMotionEvents">false</item>

    </style>

    <style name="AppTheme_FullScreen" parent="AppTheme_Default">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme_FullScreen_main" parent="AppTheme_Default">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>