<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!--Bl check-->
    <LinearLayout
        android:id="@+id/llBlCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:layout_marginTop="75dp"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal">

        <!--ibFind > ibBluetooth-->
        <CheckBox
            android:id="@+id/cbBluetooth"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerHorizontal="true"
            android:layout_marginRight="40dp"
            android:focusable="false"
            android:clickable="false"
            android:background="@drawable/imagebutton_bluetooth_toggle_selector"
            android:button="@android:color/transparent"
            />

        <!--ibConnect > ibFindAndPair-->
        <ImageButton
            android:id="@+id/ibFindAndPair"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerHorizontal="true"
            android:layout_marginRight="40dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            android:src="@drawable/findnpair" />

        <!--ibOpenDevice > ibToggle -->
        <CheckBox
            android:id="@+id/cbToggle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerHorizontal="true"
            android:layout_marginRight="20dp"
            android:checked="false"
            android:button="@android:color/transparent"
            android:background="@drawable/checkbox_toggle_selector" />

    </LinearLayout>

    <!--android:background="@drawable/round_mic"-->
    <RelativeLayout
        android:id="@+id/stt_ui"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_below="@id/llBlCheck"
        android:layout_centerInParent="true"
        android:layout_marginTop="64.33dp"
        android:background="@android:color/transparent"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/rlVoiceIntoract"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:alpha="0.1"
            android:background="@drawable/voicemonitor">
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            android:background="@drawable/mic_off" />
    </RelativeLayout>


    <TextView
        android:id="@+id/tvLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/stt_ui"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="17.33dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@android:color/black"
        android:textSize="17dp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tvResultValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvLoading"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="17.33dp"
        android:gravity="center_vertical"
        android:text=""
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:textColor="@android:color/black"
        android:textSize="20dp"
        android:textStyle="bold" />

</RelativeLayout>